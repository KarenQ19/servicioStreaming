// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String? // Opcional para usuarios de redes sociales
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campos para autenticación social
  googleId   String?       @unique
  facebookId String?       @unique
  proveedor  TipoProveedor @default(LOCAL)
  avatar     String?

  // Relaciones
  suscripciones   Suscripcion[]
  carritos        Carrito[]
  pagos           Pago[]
  credenciales    Credenciales[]
  validacionesOCR ValidacionOCR[]

  @@map("clientes")
}

model Administrador {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  serviciosCreados Servicio[]

  @@map("administradores")
}

model Servicio {
  id               String   @id @default(cuid())
  nombre           String
  descripcion      String
  precio           Float
  categoria        String
  disponible       Boolean  @default(true)
  logoUrl          String?  @map("logo_url")
  caracteristicas  Json?
  credencialesBase Json? // Pool de credenciales configuradas por el admin
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  administradorId String
  administrador   Administrador @relation(fields: [administradorId], references: [id])

  suscripciones Suscripcion[]
  carritoItems  CarritoItem[]
  credenciales  Credenciales[]

  @@map("servicios")
}

model Suscripcion {
  id          String            @id @default(cuid())
  estado      EstadoSuscripcion @default(ACTIVA)
  fechaInicio DateTime          @default(now())
  fechaFin    DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relaciones
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  credenciales Credenciales[]
  pagos        Pago[]

  @@map("suscripciones")
}

model Credenciales {
  id        String   @id @default(cuid())
  usuario   String
  password  String
  activas   Boolean  @default(true)
  asignadas Boolean  @default(false) // Si están asignadas a un cliente
  urlAcceso String? // URL del servicio
  notas     String? // Notas adicionales del admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  suscripcionId String?
  suscripcion   Suscripcion? @relation(fields: [suscripcionId], references: [id])

  @@map("credenciales")
}

model Carrito {
  id        String   @id @default(cuid())
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  items CarritoItem[]
  pagos Pago[]

  @@map("carritos")
}

model CarritoItem {
  id        String   @id @default(cuid())
  cantidad  Int      @default(1)
  precio    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  carritoId String
  carrito   Carrito @relation(fields: [carritoId], references: [id], onDelete: Cascade)

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  @@map("carrito_items")
}

model MetodoPago {
  id          String         @id @default(cuid())
  nombre      String
  tipo        TipoMetodoPago @unique
  disponible  Boolean        @default(true)
  descripcion String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relaciones
  pagos Pago[]

  @@map("metodos_pago")
}

model Pago {
  id              String     @id @default(cuid())
  monto           Float
  estado          EstadoPago @default(PENDIENTE)
  referencia      String?    @unique
  descripcion     String?
  fechaValidacion DateTime? // Fecha cuando se validó el pago
  validadoPor     String? // Método de validación: 'OCR', 'MANUAL', etc.
  createdAt       DateTime   @default(now())
  comprobanteUrl  String? // Ruta del comprobante subido
  updatedAt       DateTime   @updatedAt

  // Relaciones
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  carritoId String?
  carrito   Carrito? @relation(fields: [carritoId], references: [id])

  suscripcionId String?
  suscripcion   Suscripcion? @relation(fields: [suscripcionId], references: [id])

  metodoPagoId String
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [id])

  qr              QR[]
  validacionesOCR ValidacionOCR[]

  @@map("pagos")
}

model QR {
  id        String   @id @default(cuid())
  codigo    String   @unique
  estado    EstadoQR @default(ACTIVO)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  pagoId String
  pago   Pago   @relation(fields: [pagoId], references: [id])

  @@map("qr_codes")
}

model ValidacionOCR {
  id             String @id @default(cuid())
  imagenUrl      String
  textoExtraido  String
  datosExtraidos Json // Objeto JSON con monto, fecha, referencia, etc.
  confianzaOCR   Float // Porcentaje de confianza del OCR (0-100)

  // Datos extraídos del comprobante
  montoDetectado       String?
  fechaDetectada       String?
  referenciaDetectada  String?
  transaccionDetectada String?
  bancoDetectado       String?

  // Resultados de la validación
  esValido                Boolean
  coincidenciaMonto       Boolean @default(false)
  coincidenciaFecha       Boolean @default(false)
  coincidenciaReferencia  Boolean @default(false)
  coincidenciaTransaccion Boolean @default(false)
  porcentajeCoincidencia  Float // Porcentaje total de coincidencia (0-100)

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  pagoId    String
  pago      Pago    @relation(fields: [pagoId], references: [id])
  usuarioId String
  usuario   Cliente @relation(fields: [usuarioId], references: [id])

  @@map("validaciones_ocr")
}

// Enums
enum EstadoSuscripcion {
  ACTIVA
  PAUSADA
  CANCELADA
  EXPIRADA
}

enum TipoMetodoPago {
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA
  QR
  EFECTIVO
}

enum EstadoPago {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
}

enum EstadoQR {
  ACTIVO
  USADO
  EXPIRADO
}

enum TipoProveedor {
  LOCAL
  GOOGLE
  FACEBOOK
}
