# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=tu-secreto-de-sesion-seguro-cambiar-en-produccion
API_PREFIX=/api/v1

# ============================================
# CONFIGURACIÓN DE BASE DE DATOS (PostgreSQL 18)
# ============================================
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_base_datos
# Después de crear la BD, reemplazar con:
# DATABASE_URL=postgresql://streaming_user:streaming_pass_123@localhost:5432/streaming_service_db?schema=public
DATABASE_URL="postgresql://streaming_user:streaming_pass_123@localhost:5432/streaming_service_db?schema=public"


# ============================================
# CONFIGURACIÓN DE PASSPORT (Redes Sociales)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=tu_facebook_app_id
FACEBOOK_APP_SECRET=tu_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# ============================================
# CONFIGURACIÓN DE JWT
# ============================================
JWT_SECRET=tu-secreto-jwt-cambiar-en-produccion
JWT_EXPIRATION=7d

# ============================================
# CONFIGURACIÓN DE OCR
# ============================================
# Ruta a datos de Tesseract (si es necesario)
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

# ============================================
# CONFIGURACIÓN DE CORREO (Opcional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-app
SMTP_FROM=noreply@streamingservice.com

# ============================================
# CONFIGURACIÓN DE ARCHIVOS
# ============================================
# Máximo tamaño de carga (en MB)
MAX_FILE_SIZE=10

# Directorios
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
QR_DIR=./qr_img
